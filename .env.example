# Server
PORT=3002
NODE_ENV=development

# Database: set USE_MYSQL=true for production, otherwise in-memory JSON
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_teaching_edulab

# Python
PYTHON_BIN=python3

# Worker
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL=2000

# Artifacts
LESSON_ARTIFACTS_ROOT=./server/uploads/lessons

# Auth
SESSION_TTL_HOURS=168

# Demo accounts (seeded on first start, memory mode only)
SEED_DEMO_ACCOUNTS=false
DEMO_ADMIN_EMAIL=admin@edulab.local
DEMO_ADMIN_PASSWORD=

# AI / Sub2API (server-side only)
AI_ENABLED=true
AI_ALLOW_ROLES=student,teacher,admin
AI_QUOTA_STUDENT=10
AI_QUOTA_TEACHER=50
AI_QUOTA_ADMIN=200
AI_MAX_REPAIR_ATTEMPTS=3
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_MODEL=
SUB2API_VISION_MODEL=
SUB2API_TIMEOUT_MS=120000
SUB2API_MAX_RETRIES=2
SUB2API_USER_AGENT=OpenAI/JS 4.73.0

# Molecule auto-extension store (M2)
# MOLECULE_EXTENSIONS_FILE=./server/data/molecule-extensions.json
