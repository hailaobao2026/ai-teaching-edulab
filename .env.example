# Server
PORT=3002
NODE_ENV=development

# Database: set USE_MYSQL=true for production, otherwise in-memory JSON
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_teaching_edulab

# Python
PYTHON_BIN=python3

# Worker
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL=2000

# Artifacts
LESSON_ARTIFACTS_ROOT=./server/uploads/lessons

# Auth
SESSION_TTL_HOURS=168

# Demo accounts (seeded on first start, memory mode only)
SEED_DEMO_ACCOUNTS=false
DEMO_ADMIN_EMAIL=admin@edulab.local
DEMO_ADMIN_PASSWORD=
